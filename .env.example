# Required. Postgres password for the durable session store.
POSTGRES_PASSWORD=

# Host port the runtime is published on. Loopback only.
WANIWANI_AGENT_PORT=3001

# WaniWani region URL. Defaults to https://app.waniwani.ai.
WANIWANI_API_URL=

# MCP origin, when the address WaniWani publishes is not the one reachable from here.
WANIWANI_MCP_URL=

# `ingest` reports transcripts to WaniWani, `off` reports nothing.
WANIWANI_ANALYTICS=off
# Public analytics key. Required when analytics are on.
WANIWANI_PUBLIC_KEY=

# Key for your own model, when the published configuration carries none.
MODEL_API_KEY=

# Context window the runtime assumes for a model it cannot look up.
WANIWANI_MODEL_CONTEXT_WINDOW_TOKENS=32000
