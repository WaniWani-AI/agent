# The WaniWani-hosted runtime: a visitor JWT names the environment, and the
# config fetch proves itself with a service token.
STACK=hosted
WANIWANI_API_KEY=
WANIWANI_AGENT_SECRET=ci-agent-secret
WANIWANI_SERVICE_PRIVATE_KEY_FILE=/run/keys/service.key
WANIWANI_REGION=eu
WANIWANI_CHANNEL_ID=
MODEL_API_KEY=
AI_GATEWAY_API_KEY=test
AI_GATEWAY_BASE_URL=http://model:3003/v1
FIXTURE_MODEL_MODE=managed
SERVICE_PUBLIC_KEY_FILE=/run/keys/service.pub
